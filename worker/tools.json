              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "forward"
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "reload"
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "click"
                  },
                  "target": {
                    "$ref": "#/$defs/target"
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1920
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1600
                  },
                  "button": {
                    "enum": [
                      "left",
                      "middle",
                      "right"
                    ]
                  },
                  "click_count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2
                  },
                  "modifiers": {
                    "type": "array",
                    "maxItems": 4,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "Alt",
                        "Control",
                        "Meta",
                        "Shift"
                      ]
                    }
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false,
                "oneOf": [
                  {
                    "required": [
                      "target"
                    ],
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "x"
                          ]
                        },
                        {
                          "required": [
                            "y"
                          ]
                        }
                      ]
                    }
                  },
                  {
                    "required": [
                      "x",
                      "y"
                    ],
                    "not": {
                      "required": [
                        "target"
                      ]
                    }
                  }
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "hover"
                  },
                  "target": {
                    "$ref": "#/$defs/target"
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1920
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1600
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false,
                "oneOf": [
                  {
